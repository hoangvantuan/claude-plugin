#!/bin/bash
# Writer-Agent: Output skill directory paths
# Used by main agent to resolve paths at runtime (Step 0)
# Works regardless of installation location (project-local or global)
# MUST be invoked with absolute path: source /full/path/to/wa-env

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_ROOT="$(pwd)"

# Validate: SCRIPT_DIR must end with /scripts and SKILL_DIR must contain voices/
if [[ "$(basename "$SCRIPT_DIR")" != "scripts" ]]; then
  echo "ERROR: wa-env resolved SCRIPT_DIR=$SCRIPT_DIR (expected */scripts/)" >&2
  echo "HINT: Invoke with absolute path: source /full/path/to/writer-agent/scripts/wa-env" >&2
  return 1 2>/dev/null || exit 1
fi

if [[ ! -d "$SKILL_DIR/voices" ]]; then
  echo "ERROR: SKILL_DIR=$SKILL_DIR does not contain voices/ directory" >&2
  echo "HINT: Skill structure is broken. Re-install the plugin." >&2
  return 1 2>/dev/null || exit 1
fi

echo "SCRIPTS_DIR=$SCRIPT_DIR"
echo "SKILL_DIR=$SKILL_DIR"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "OUTPUT_DIR=$PROJECT_ROOT/writer-agent"
echo "VOICES_DIR=$SKILL_DIR/voices"
echo "STRUCTURES_DIR=$SKILL_DIR/structures"
echo "IDENTITIES_DIR=$SKILL_DIR/identities"
echo "AUDIENCES_DIR=$SKILL_DIR/audiences"
echo "EMOTIONS_DIR=$SKILL_DIR/emotional_maps"
echo "TEMPLATES_DIR=$SKILL_DIR/templates"
echo "REFERENCES_DIR=$SKILL_DIR/references"
